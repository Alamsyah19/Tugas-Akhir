<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Data Ayah -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Data Ayah"
            android:textStyle="bold"
            android:textSize="20dp" />

        <EditText
            android:id="@+id/txtNikAyah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="NIK Ayah"/>

        <EditText
            android:id="@+id/txtNamaAyah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama Ayah" />

        <EditText
            android:id="@+id/txtTglLahirAyah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tanggal Lahir Ayah" />

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- Data Ibu -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Data Ibu"
            android:textStyle="bold"
            android:textSize="20dp" />

        <EditText
            android:id="@+id/txtNikIbu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="NIK Ibu" />

        <EditText
            android:id="@+id/txtNamaIbu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama Ibu" />

        <EditText
            android:id="@+id/txtTglLahirIbu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tanggal Lahir Ibu" />

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- Alamat -->
        <EditText
            android:id="@+id/txtAlamat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Alamat" />
        <!--Ibu Kb-->
        <EditText
            android:id="@+id/txtIbuKb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ibu KB" />

        <!-- Nomor HP -->
        <EditText
            android:id="@+id/txtNoHp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nomor HP" />


        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hapus"
            android:layout_marginTop="8dp"
            android:backgroundTint="@android:color/holo_red_light"
            android:textColor="@android:color/white"/>

    </LinearLayout>
</ScrollView>